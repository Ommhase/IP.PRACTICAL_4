# ==========================================================
# Question 6: Number Reversal and Palindrome Check
# ==========================================================
print("--- Question 6 ---")
num_input = int(input("Enter a number: "))
original = num_input
reverse = 0

temp = abs(num_input)
while temp > 0:
    digit = temp % 10
    reverse = (reverse * 10) + digit
    temp //= 10

if num_input < 0:
    reverse = -reverse

print("Reversed Number:", reverse)
if original == reverse:
    print("The number is a Palindrome.\n")
else:
    print("The number is not a Palindrome.\n")


# ==========================================================
# Question 7: Count Digits, Even and Odd
# ==========================================================
print("--- Question 7 ---")
n = int(input("Enter a number: "))
temp = abs(n)
even_count = 0
odd_count = 0

if temp == 0:
    even_count = 1
else:
    while temp > 0:
        digit = temp % 10
        if digit % 2 == 0:
            even_count += 1
        else:
            odd_count += 1
        temp //= 10

total_digits = even_count + odd_count
print(f"Total digits: {total_digits}")
print(f"Even digits : {even_count}")
print(f"Odd digits  : {odd_count}\n")


# ==========================================================
# Question 8: Prime Number Checker
# ==========================================================
print("--- Question 8 ---")
# 1. Check an individual number
check_num = int(input("Enter a number to check if prime: "))
if check_num > 1:
    is_prime = True
    for i in range(2, int(check_num ** 0.5) + 1):
        if check_num % i == 0:
            is_prime = False
            break
    if is_prime:
        print(f"{check_num} is a Prime number.")
    else:
        print(f"{check_num} is not a Prime number.")
else:
    print(f"{check_num} is not a Prime number.")

# 2. Primes between 1 and 100
print("\nPrime numbers between 1 and 100:")
for num in range(2, 101):
    for i in range(2, int(num ** 0.5) + 1):
        if num % i == 0:
            break
    else:
        print(num, end=" ")
print("\n")


# ==========================================================
# Question 9: Fibonacci Series
# ==========================================================
print("--- Question 9 ---")
terms = int(input("Enter the number of terms: "))
a, b = 0, 1

print("Fibonacci series:")
for _ in range(terms):
    print(a, end=" ")
    a, b = b, a + b
print("\n")


# ==========================================================
# Question 10: Nested Loops (Patterns)
# ==========================================================
print("--- Question 10 ---")
rows = 5

print("Ascending Pattern:")
for i in range(1, rows + 1):
    for j in range(1, i + 1):
        print("*", end=" ")
    print()

print("\nReverse Pattern:")
for i in range(rows, 0, -1):
    for j in range(1, i + 1):
        print("*", end=" ")
    print()
