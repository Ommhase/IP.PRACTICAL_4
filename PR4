<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technology Suggestion Form</title>
</head>
<body>
    <h1>Technology Suggestion Form</h1>
    <form action="#" method="post">
        <label>Technology Name: <input type="text" name="technology" required></label><br><br>
        <label>Organization: <input type="text" name="organization" required></label><br><br>
        <label>Email: <input type="email" name="email" required></label><br><br>

        <label>Category:
            <select name="category" required>
                <option value="">Choose</option>
                <option value="AI">Artificial Intelligence</option>
                <option value="Cloud">Cloud Computing</option>
                <option value="Cyber">Cyber Security</option>
                <option value="IoT">IoT</option>
                <option value="Blockchain">Blockchain</option>
            </select>
        </label><br><br>

        <p>Impact level:</p>
        <label><input type="radio" name="impact" value="High" required> High</label>
        <label><input type="radio" name="impact" value="Medium"> Medium</label>
        <label><input type="radio" name="impact" value="Low"> Low</label><br><br>

        <p>Application areas:</p>
        <label><input type="checkbox" name="areas[]" value="Healthcare"> Healthcare</label>
        <label><input type="checkbox" name="areas[]" value="Education"> Education</label>
        <label><input type="checkbox" name="areas[]" value="Finance"> Finance</label><br><br>

        <label>Description:<br>
            <textarea name="description" rows="4" cols="40"></textarea>
        </label><br><br>

        <label>Contact: <input type="tel" name="contact" pattern="[0-9]{10}" placeholder="10-digit number" required></label><br><br>
        <label>Website: <input type="url" name="website" placeholder="https://example.com"></label><br><br>
        <label>Submission date: <input type="date" name="submission_date"></label><br><br>
        <label>Year: <input type="number" name="year" min="1900" max="2100"></label><br><br>
        <label>Rating: <input type="range" name="rating" min="1" max="10"></label><br><br>

        <button type="submit">Submit</button>
        <button type="reset">Reset</button>
    </form>
</body>
</html>
