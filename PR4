# ==========================================================
# Question 1: Understand for Loop Syntax and range
# ==========================================================
print("--- Question 1 ---")
# Print numbers from 1 to 10
print("Numbers from 1 to 10:")
for i in range(1, 11):
    print(i, end=" ")
print()

# Print only even numbers
print("Even numbers from 2 to 10:")
for i in range(2, 11, 2):
    print(i, end=" ")
print("\n")


# ==========================================================
# Question 2: While Loop Fundamentals
# ==========================================================
print("--- Question 2 ---")
# Print numbers 1 to 10 using while loop
i = 1
while i <= 10:
    print(i, end=" ")
    i += 1
print("\n")


# ==========================================================
# Question 3: Sum and Average Using Loop
# ==========================================================
print("--- Question 3 ---")
n = int(input("Enter how many numbers you want to input: "))
total_sum = 0

for i in range(n):
    val = float(input(f"Enter number {i + 1}: "))
    total_sum += val

avg = total_sum / n if n > 0 else 0

print(f"Sum    : {total_sum}")
print(f"Average: {avg:.2f}\n")


# ==========================================================
# Question 4: Factorial Calculation (for and while loops)
# ==========================================================
print("--- Question 4 ---")
num = int(input("Enter a number to find its factorial: "))

# Implementation 1: Using for loop
fact_for = 1
for i in range(1, num + 1):
    fact_for *= i
print(f"Factorial using for loop  : {fact_for}")

# Implementation 2: Using while loop
fact_while = 1
temp = num
while temp > 1:
    fact_while *= temp
    temp -= 1
print(f"Factorial using while loop: {fact_while}\n")


